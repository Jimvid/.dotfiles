{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "hide_root": false,
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "indent_size": 20.0,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "dock": "left"
  },
  "active_pane_modifiers": {
    "border_size": 0.0
  },
  "title_bar": {
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "amazon-bedrock",
      "model": "claude-opus-4-6",
    },
    "model_parameters": [],
  },
  "cursor_shape": "block",
  "ui_font_family": "Geist",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "GeistMono Nerd Font Mono",
  "terminal": {
    "dock": "bottom",
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "base_keymap": "Cursor",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Rosé Pine"
  },
}
